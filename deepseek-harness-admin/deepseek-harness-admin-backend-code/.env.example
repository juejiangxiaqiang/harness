# 文件说明：Harness 管理后台环境变量模板。
# 复制为 .env 并按需填写；敏感值（数据库密码、API Key）不得提交到仓库。
# 启动方式示例（PowerShell）：$env:DB_PASSWORD="123456"; mvn spring-boot:run

# ---- MySQL（必需）----
# 数据库需先创建：CREATE DATABASE harness_admin DEFAULT CHARACTER SET utf8mb4;
DB_URL=jdbc:mysql://localhost:3306/harness_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=123456

# ---- 服务端口（可选）----
# SERVER_PORT=8080

# ---- 知识库原始文件存储目录（可选）----
# KNOWLEDGE_BASE_DIR=./data/knowledge-bases

# ---- OpenAI 兼容 Embedding（可选）----
# SPRING_AI_EMBEDDING_PROVIDER=openai 时接入 OpenAI 兼容服务（并配置下方 API Key）；
# 保持 local（默认）则使用本地缺省向量模型，无需任何外部依赖
SPRING_AI_EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Redis 向量库（可选，需 RediSearch 模块）----
# SPRING_AI_VECTORSTORE_TYPE=redis 时使用 Redis 向量库（持久化）；local 为内存实现（仅开发）
SPRING_AI_VECTORSTORE_TYPE=local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_VECTOR_INDEX=harness_kb_index
REDIS_VECTOR_PREFIX=kb:

# ---- 初始管理员 ----
# 本次采用直接向数据库插入管理员（见 docs/DEPLOYMENT.md 管理员初始化说明，password_hash 需 BCrypt）。
# 如需启动自动创建，可配置：
# harness.bootstrap-admin.username=admin
# harness.bootstrap-admin.password=<管理员密码>

# ---- 认证 / 上传 / 向量化参数（全部有默认值，可省略）----
# harness.auth.token-expire-hours=24
# harness.auth.max-login-attempts=5
# harness.auth.lock-minutes=15
# harness.storage.allowed-extensions=txt,md,pdf,docx
# harness.storage.max-file-size-mb=20
# harness.vectorization.max-retries=2
# harness.vectorization.backoff-base-seconds=2
# harness.vectorization.chunk-max-chars=800
# LOG_LEVEL=INFO
